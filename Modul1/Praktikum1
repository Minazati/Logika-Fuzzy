import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# 1. RANCANG LOGIKA CRISP
# Batas waktu >= 8 jam sebagai tiket kritis
# ============================================================

def crisp_kritis(waktu):
    if waktu >= 8:
        return 1
    else:
        return 0


# ============================================================
# 2. RANCANG LOGIKA FUZZY
#
# Waktu < 4 jam       : derajat kritis = 0
# 4 <= waktu <= 12    : derajat kritis naik secara linear
# Waktu > 12 jam      : derajat kritis = 1
#
# Persamaan:
#
#       0,                 x < 4
# μ(x)= (x - 4) / (12-4),  4 <= x <= 12
#       1,                 x > 12
# ============================================================

def fuzzy_kritis(waktu):
    if waktu < 4:
        return 0
    elif waktu <= 12:
        return (waktu - 4) / (12 - 4)
    else:
        return 1


# ============================================================
# 3. IMPLEMENTASI DALAM PYTHON
# Pengujian data:
# 2, 4, 6, 7.9, 8.0, 8.1, 10, 12, 16, 24 jam
# ============================================================

data_uji = [2, 4, 6, 7.9, 8.0, 8.1, 10, 12, 16, 24]


# ============================================================
# TABEL PERBANDINGAN CRISP DAN FUZZY
# ============================================================

print("=" * 55)
print("PERBANDINGAN LOGIKA CRISP DAN FUZZY")
print("Sistem Prioritas Tiket Helpdesk TI")
print("=" * 55)

print(
    f"{'Waktu (jam)':<15}"
    f"{'Crisp':<15}"
    f"{'Fuzzy':<15}"
)

print("-" * 55)

for waktu in data_uji:
    hasil_crisp = crisp_kritis(waktu)
    hasil_fuzzy = fuzzy_kritis(waktu)

    print(
        f"{waktu:<15.1f}"
        f"{hasil_crisp:<15}"
        f"{hasil_fuzzy:<15.3f}"
    )


# ============================================================
# 4. VISUALISASIKAN
# Membuat grafik perbandingan Crisp dan Fuzzy
# ============================================================

waktu = np.linspace(0, 24, 500)

nilai_crisp = [crisp_kritis(x) for x in waktu]
nilai_fuzzy = [fuzzy_kritis(x) for x in waktu]


plt.figure(figsize=(10, 6))

plt.plot(
    waktu,
    nilai_crisp,
    label="Logika Crisp",
    linewidth=2
)

plt.plot(
    waktu,
    nilai_fuzzy,
    label="Logika Fuzzy",
    linewidth=2
)

plt.xlabel("Waktu Tunggu Penyelesaian Tiket (Jam)")
plt.ylabel("Derajat Kritis")
plt.title("Perbandingan Logika Crisp dan Fuzzy\nSistem Prioritas Tiket Helpdesk TI")

plt.xlim(0, 24)
plt.ylim(-0.05, 1.05)

plt.grid(True, linestyle="--", alpha=0.5)
plt.legend()

# Menyimpan grafik dalam format PNG
plt.savefig(
    "perbandingan_crisp_fuzzy.png",
    format="png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()
