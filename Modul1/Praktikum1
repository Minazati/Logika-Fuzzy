import numpy as np
import matplotlib.pyplot as plt


# Fungsi Crisp
def crisp(x):
    return np.where(x >= 8, 1, 0)


# Fungsi Fuzzy Linear Naik
def fuzzy_linear(x):
    return np.where(
        x < 4,
        0,
        np.where(
            x <= 12,
            (x - 4) / (12 - 4),
            1
        )
    )


# Fungsi Fuzzy Sigmoid
def fuzzy_sigmoid(x, x0=3.5, k=2.0):
    return 1 / (1 + np.exp(-k * (x - x0)))


# Domain waktu 0 sampai 24 jam
x = np.linspace(0, 24, 500)


# Hitung masing-masing fungsi
y_crisp = crisp(x)
y_linear = fuzzy_linear(x)
y_sigmoid = fuzzy_sigmoid(x)


# Grafik
plt.figure(figsize=(10, 6))

plt.plot(
    x,
    y_crisp,
    label="Crisp",
    linewidth=2
)

plt.plot(
    x,
    y_linear,
    label="Fuzzy Linear",
    linewidth=2
)

plt.plot(
    x,
    y_sigmoid,
    label="Fuzzy Sigmoid",
    linewidth=2
)


plt.xlabel("Waktu Tunggu (Jam)")
plt.ylabel("Derajat Keanggotaan")
plt.title("Perbandingan Crisp, Fuzzy Linear, dan Fuzzy Sigmoid")

plt.xlim(0, 24)
plt.ylim(-0.05, 1.05)

plt.grid(True, linestyle="--", alpha=0.5)
plt.legend()

plt.show()


