import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# 1. FUNGSI KARAKTERISTIK CRISP
# ============================================================
def crisp_memuaskan(x, theta=4.0):
    """
    Fungsi karakteristik Crisp/Boolean.

    μ(x) = 1, jika x >= theta
           0, jika x < theta
    """
    return np.where(x >= theta, 1, 0)


# ============================================================
# 2. FUNGSI KEANGGOTAAN FUZZY LINEAR NAIK
# ============================================================
def fuzzy_memuaskan(x, a=2.5, b=4.5):
    """
    Fungsi keanggotaan fuzzy linear naik.

    μ(x) = 0                  , x < a
         = (x-a)/(b-a)        , a <= x <= b
         = 1                  , x > b
    """

    x = np.asarray(x)

    return np.where(
        x < a,
        0,
        np.where(
            x <= b,
            (x - a) / (b - a),
            1
        )
    )


# ============================================================
# 3. DOMAIN / SEMESTA PEMBICARAAN
# ============================================================
x = np.linspace(1, 5, 500)


# ============================================================
# 4. HITUNG NILAI CRISP DAN FUZZY
# ============================================================
crisp = crisp_memuaskan(x)
fuzzy = fuzzy_memuaskan(x)


# ============================================================
# 5. MENAMPILKAN GRAFIK PERBANDINGAN
# ============================================================
plt.figure(figsize=(10, 6))

plt.plot(
    x,
    crisp,
    label="Logika Crisp",
    linewidth=3
)

plt.plot(
    x,
    fuzzy,
    label="Logika Fuzzy",
    linewidth=3
)

# Garis ambang Crisp
plt.axvline(
    x=4.0,
    linestyle="--",
    linewidth=1.5,
    label="Ambang Crisp = 4.0"
)

# Titik batas fuzzy
plt.axvline(
    x=2.5,
    linestyle=":",
    linewidth=1.5,
    label="Batas Fuzzy = 2.5"
)

plt.axvline(
    x=4.5,
    linestyle=":",
    linewidth=1.5,
    label="Batas Fuzzy = 4.5"
)

plt.title(
    "Perbandingan Fungsi Keanggotaan Crisp dan Fuzzy",
    fontsize=14
)

plt.xlabel("Rating Layanan", fontsize=12)
plt.ylabel("Derajat Keanggotaan μ(x)", fontsize=12)

plt.xticks(np.arange(1, 5.1, 0.5))
plt.yticks(np.arange(0, 1.1, 0.1))

plt.ylim(-0.05, 1.1)
plt.grid(True, linestyle="--", alpha=0.5)
plt.legend()

plt.show()


