# 7. PROGRAM UTAMA
# =============================================================================
def main():
    print("=" * 70)
    print("VALIDASI OVERLAP KURVA")
    print("=" * 70)
    semua_lolos = True
    for var in SEMUA_VARIABEL.values():
        lolos, pesan = cek_overlap(var)
        semua_lolos &= lolos
        print(f"[{'OK' if lolos else 'GAGAL'}] {var.nama}")
        for p in pesan:
            print("      -", p)
    print("Hasil keseluruhan:", "SEMUA LOLOS" if semua_lolos else "ADA YANG GAGAL")

    print("\n" + "=" * 70)
    print("VISUALISASI")
    print("=" * 70)
    for var in SEMUA_VARIABEL.values():
        print("Tersimpan:", plot_variabel(var))
    print("Tersimpan:", plot_semua())
    print("Tersimpan:", plot_titik_uji(KASUS_UJI))

    print("\n" + "=" * 70)
    print("HASIL FUZZIFIKASI")
    print("=" * 70)
    baris = jalankan_pengujian()
    for b in baris:
        print(f"\n[{b['no']}] {b['kasus']}  -> {b['input']}")
        for nama, d in b["derajat"].items():
            lab, nilai = b["dominan"][nama]
            print(f"    {nama:<12}: {format_derajat(d)}   | dominan: {lab} ({nilai:.2f})")
    path_csv = os.path.join(DIR_KELUARAN, "hasil_fuzzifikasi.csv")
    simpan_csv(baris, path_csv)
    print("\nTersimpan:", path_csv)


if __name__ == "__main__":
    main()
