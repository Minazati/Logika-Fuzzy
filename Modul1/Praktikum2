# ======================================================================
cpu_utilization = {
    "nama": "Penggunaan CPU Server (CPU Utilization)",
    "semesta": (0, 100),
    "satuan": "%",
    "terms": {
        "Rendah": {"tipe": "bahu_kiri",  "param": (20, 40),
                   "fungsi": lambda x: bahu_kiri(x, 20, 40)},
        "Normal": {"tipe": "segitiga",   "param": (30, 50, 70),
                   "fungsi": lambda x: segitiga(x, 30, 50, 70)},
        "Tinggi": {"tipe": "bahu_kanan", "param": (60, 80),
                   "fungsi": lambda x: bahu_kanan(x, 60, 80)},
    },
}


# ======================================================================
# FUZZIFIKASI
# ======================================================================
def fuzzifikasi(var, x_crisp):
    u0, u1 = var["semesta"]
    if not (u0 <= x_crisp <= u1):
        raise ValueError(f"Input {x_crisp} di luar semesta [{u0}, {u1}]")
    return {nama: float(t["fungsi"](x_crisp)) for nama, t in var["terms"].items()}


def tentukan_label(hasil):
    """Label dengan mu tertinggi; jika seri -> 'Imbang (A/B)'."""
    maks = max(hasil.values())
    if maks == 0:
        return "-"
    dom = [k for k, v in hasil.items() if np.isclose(v, maks)]
    return dom[0] if len(dom) == 1 else f"Imbang ({'/'.join(dom)})"


def tampilkan_tabel(var, daftar_input):
    nama = list(var["terms"].keys())
    print("=" * 66)
    print(f"TABEL FUZZIFIKASI - {var['nama']}")
    print("=" * 66)
    print(f"{'No':<4}{'Input (x)':<12}" + "".join(f"{'mu ' + n:<12}" for n in nama)
          + "Label Dominan")
    print("-" * 66)
    for no, x in enumerate(daftar_input, start=1):
        h = fuzzifikasi(var, x)
        print(f"{no:<4}{str(x) + var['satuan']:<12}"
              + "".join(f"{h[n]:<12.3f}" for n in nama)
              + tentukan_label(h))
    print()


