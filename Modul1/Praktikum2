# ======================================================================
# 3. DOMAIN HIMPUNAN FUZZY  (daerah dengan mu(x) > 0)
# ======================================================================
def domain_term(var, nama_term, resolusi=0.001):
    """Domain = rentang x pada semesta dengan derajat keanggotaan > 0."""
    u0, u1 = var["semesta"]
    x = np.arange(u0, u1 + resolusi, resolusi)
    mu = var["terms"][nama_term]["fungsi"](x)
    aktif = x[mu > 0]
    if aktif.size == 0:
        return None
    return round(float(aktif.min()), 3), round(float(aktif.max()), 3)


# ======================================================================
# 4. FUZZIFIKASI
# ======================================================================
def fuzzifikasi(var, x_crisp):
    """Mengubah input crisp menjadi derajat keanggotaan tiap label."""
    u0, u1 = var["semesta"]
    if not (u0 <= x_crisp <= u1):
        raise ValueError(f"Input {x_crisp} di luar semesta [{u0}, {u1}]")
    return {nama: float(t["fungsi"](x_crisp)) for nama, t in var["terms"].items()}


def label_dominan(hasil):
    """Label dengan derajat keanggotaan tertinggi (bisa lebih dari satu jika sama)."""
    maks = max(hasil.values())
    if maks == 0:
        return [], 0.0
    return [k for k, v in hasil.items() if np.isclose(v, maks)], maks


def cetak_fuzzifikasi(var, x_crisp):
    hasil = fuzzifikasi(var, x_crisp)
    print(f"Input crisp x = {x_crisp} {var['satuan']}")
    for nama, mu in hasil.items():
        print(f"  mu_{nama}({x_crisp}) = {mu:.2f}")
    aktif = {k: v for k, v in hasil.items() if v > 0}
    teks = " dan ".join(f"{k} dengan derajat {v:.2f}" for k, v in aktif.items())
    print(f"  Hasil Fuzzifikasi: sistem mengenali kondisi sebagai {teks}.")
    dom, nilai = label_dominan(hasil)
    if len(dom) == 1:
        print(f"  Label dominan    : {dom[0]} ({nilai:.2f})")
    elif len(dom) > 1:
        print(f"  Label dominan    : {' = '.join(dom)} (seri, derajat {nilai:.2f})")
    print()
    return hasil


# ======================================================================
# 5. ANALISIS DAERAH TUMPANG TINDIH (OVERLAPPING)
# ======================================================================
def analisis_overlap(var, resolusi=0.001):
    """Mencari interval x di mana dua label (atau lebih) sama-sama mu > 0."""
    u0, u1 = var["semesta"]
    x = np.arange(u0, u1 + resolusi, resolusi)
    nama = list(var["terms"].keys())
    mu = {n: var["terms"][n]["fungsi"](x) for n in nama}

    print("=" * 62)
    print("ANALISIS DAERAH TUMPANG TINDIH (OVERLAPPING)")
    print("=" * 62)
    hasil = []
    for i in range(len(nama)):
        for j in range(i + 1, len(nama)):
            a, b = nama[i], nama[j]
            irisan = (mu[a] > 0) & (mu[b] > 0)
            if irisan.any():
                lo, hi = x[irisan].min(), x[irisan].max()
                # titik potong: tempat mu_a ~ mu_b di dalam daerah overlap
                idx = np.argmin(np.abs(mu[a][irisan] - mu[b][irisan]))
                x_pot = x[irisan][idx]
                mu_pot = mu[a][irisan][idx]
                print(f"- {a} & {b}: x dalam ({lo:.2f}, {hi:.2f}) {var['satuan']}")
                print(f"    titik potong x = {x_pot:.2f}, mu = {mu_pot:.2f}")
                hasil.append((a, b, lo, hi, x_pot, mu_pot))
            else:
                print(f"- {a} & {b}: tidak ada overlap")

    # Cek celah: x yang tidak dimiliki label manapun (mu semua = 0)
    kosong = np.all([mu[n] == 0 for n in nama], axis=0)
    print()
    if kosong.any():
        print("PERINGATAN: ada nilai input tanpa representasi label (mu = 0 semua):")
        print("  x =", np.round(x[kosong][[0, -1]], 2))
    else:
        print("Tidak ada celah: setiap nilai pada semesta punya minimal satu label.")
    print()
    return hasil


# ======================================================================
# 6. VISUALISASI
# ======================================================================
def plot_variabel(var, titik_input=None, simpan="grafik_waktu_respons.png", tampil=True):
    u0, u1 = var["semesta"]
    x = np.linspace(u0, u1, 1001)
    warna = ["tab:blue", "tab:orange", "tab:green", "tab:red", "tab:purple"]

    fig, ax = plt.subplots(figsize=(9, 5))
    for (nama, t), c in zip(var["terms"].items(), warna):
        mu = t["fungsi"](x)
        ax.plot(x, mu, label=nama, color=c, linewidth=2)
        ax.fill_between(x, mu, alpha=0.12, color=c)

    if titik_input is not None:
        hasil = fuzzifikasi(var, titik_input)
        ax.axvline(titik_input, color="gray", linestyle="--", linewidth=1)
        for (nama, mu_val), c in zip(hasil.items(), warna):
            if mu_val > 0:
                ax.plot(titik_input, mu_val, "o", color=c)
                ax.annotate(f"{mu_val:.2f}", (titik_input, mu_val),
                            textcoords="offset points", xytext=(8, 4), fontsize=9)

    ax.set_title(f"Variabel Linguistik: {var['nama'].upper()} "
                 f"(Semesta U: [{u0}, {u1}] {var['satuan']})")
    ax.set_xlabel(f"x ({var['satuan']})")
    ax.set_ylabel(r"$\mu(x)$")
    ax.set_xlim(u0, u1)
    ax.set_ylim(-0.05, 1.1)
    ax.set_xticks(range(u0, u1 + 1))
    ax.grid(alpha=0.3)
    ax.legend(title="Label")
    fig.tight_layout()
    if simpan:
        fig.savefig(simpan, dpi=150)
        print(f"Grafik disimpan ke: {simpan}")
    if tampil:
        plt.show()
    plt.close(fig)


# ======================================================================
# PROGRAM UTAMA
# ======================================================================
if __name__ == "__main__":
    info_variabel(waktu_respons)

    print("=" * 62)
    print("DOMAIN HIMPUNAN FUZZY (mu(x) > 0)")
    print("=" * 62)
    for nama in waktu_respons["terms"]:
        d = domain_term(waktu_respons, nama)
        print(f"  {nama:<7}: {d[0]} < x < {d[1]}  (batas di mana mu > 0)")
    print()

    print("=" * 62)
    print("PERHITUNGAN FUZZIFIKASI")
    print("=" * 62)
    cetak_fuzzifikasi(waktu_respons, 3.5)    # contoh pada materi: Cepat 0.25, Sedang 0.25
    for nilai in [1.0, 5.0, 6.5, 9.0]:       # contoh input tambahan
        cetak_fuzzifikasi(waktu_respons, nilai)

    analisis_overlap(waktu_respons)

    plot_variabel(waktu_respons, titik_input=3.5)



