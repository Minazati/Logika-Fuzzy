skenario_input = [1.0, 2.5, 3.5, 5.0, 6.5, 7.5, 9.0]

# Nilai yang diharapkan sesuai tabel di materi: (Cepat, Sedang, Lambat, Label Dominan)
harapan = {
    1.0: (1.000, 0.000, 0.000, "Cepat"),
    2.5: (0.750, 0.000, 0.000, "Cepat"),
    3.5: (0.250, 0.250, 0.000, "Imbang (Cepat/Sedang)"),
    5.0: (0.000, 1.000, 0.000, "Sedang"),
    6.5: (0.000, 0.250, 0.250, "Imbang (Sedang/Lambat)"),
    7.5: (0.000, 0.000, 0.750, "Lambat"),
