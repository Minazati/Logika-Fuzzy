import numpy as np
import matplotlib.pyplot as plt


# ======================================================================
# 1. FUNGSI KEANGGOTAAN (Membership Function)
# ======================================================================
def trapesium_turun(x, a, b):
    """Bahu kiri (trapesium turun).
    mu = 1 untuk x <= a ; (b - x)/(b - a) untuk a < x < b ; 0 untuk x >= b
    """
    x = np.asarray(x, dtype=float)
    return np.where(x <= a, 1.0,
           np.where(x >= b, 0.0, (b - x) / (b - a)))


def segitiga(x, a, b, c):
    """Kurva segitiga (a, b, c).
    mu = 0 untuk x <= a atau x >= c ;
         (x - a)/(b - a) untuk a < x <= b ;
         (c - x)/(c - b) untuk b < x < c
    """
    x = np.asarray(x, dtype=float)
    naik = (x - a) / (b - a)
    turun = (c - x) / (c - b)
    return np.where((x <= a) | (x >= c), 0.0,
           np.where(x <= b, naik, turun))


def trapesium_naik(x, a, b):
    """Bahu kanan (trapesium naik).
    mu = 0 untuk x <= a ; (x - a)/(b - a) untuk a < x < b ; 1 untuk x >= b
    """
    x = np.asarray(x, dtype=float)
    return np.where(x <= a, 0.0,
           np.where(x >= b, 1.0, (x - a) / (b - a)))


# ======================================================================
# 2. STRUKTUR DATA VARIABEL LINGUISTIK  (x, T(x), U, G, M)
# ======================================================================
waktu_respons = {
