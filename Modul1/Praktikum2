}


def tentukan_label(hasil):
    """Label dominan; jika derajat tertinggi sama -> 'Imbang (A/B)'."""
    dom, _ = label_dominan(hasil)
    if len(dom) == 1:
        return dom[0]
    if len(dom) > 1:
        return f"Imbang ({'/'.join(dom)})"
    return "-"


def jalankan_skenario(var, daftar_input):
    print("=" * 84)
    print("E. SKENARIO PENGUJIAN FUZZIFIKASI")
    print("=" * 84)
    print(f"{'No':<4}{'Input (x)':<11}{'mu Cepat':<11}{'mu Sedang':<11}"
          f"{'mu Lambat':<11}{'Label Dominan':<26}{'Cocok?'}")
    print("-" * 84)

    semua_cocok = True
    for no, x in enumerate(daftar_input, start=1):
        h = fuzzifikasi(var, x)
        label = tentukan_label(h)

        # Verifikasi terhadap tabel di materi
        c, s, l, lbl = harapan[x]
        cocok = (np.isclose(h["Cepat"], c) and np.isclose(h["Sedang"], s)
                 and np.isclose(h["Lambat"], l) and label == lbl)
        semua_cocok &= bool(cocok)

        print(f"{no:<4}{str(x) + ' s':<11}{h['Cepat']:<11.3f}{h['Sedang']:<11.3f}"
              f"{h['Lambat']:<11.3f}{label:<26}{'OK' if cocok else 'BEDA'}")

    print("-" * 84)
    print("Semua hasil sesuai tabel materi." if semua_cocok
          else "Ada hasil yang berbeda dari tabel materi!")
    print()


# ---------------- Jalankan ----------------
